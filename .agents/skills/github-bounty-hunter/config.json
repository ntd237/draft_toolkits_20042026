{
  "runtime_policy": {
    "default_workspace_dir": "scratch/bounties",
    "max_concurrent_tasks": 1,
    "human_in_the_loop_required": true,
    "require_confirmation_before_comment": true,
    "require_confirmation_before_pr": true,
    "zero_spam_enforcement": true
  },
  "orchestration_policy": {
    "autonomous_engine_skill": "goal-driven",
    "underlying_orchestrator": "00-orchestrator",
    "supported_pipelines": ["1", "2", "3", "4a", "4b", "5", "6", "7", "8"],
    "enforce_engine_invocation": true,
    "require_harness_log_file": true,
    "harness_log_directory": "docs/harness-logs",
    "harness_log_naming_pattern": "{category}_{task_name}_{timestamp}.md",
    "pipeline_mapping": {
      "small_feature_or_refactor": "Pipeline 1",
      "ambiguous_feature": "Pipeline 2",
      "complex_feature_or_architecture": "Pipeline 3",
      "unknown_cause_bug_simple": "Pipeline 4a",
      "unknown_cause_bug_complex": "Pipeline 4b",
      "known_cause_bug_simple": "Pipeline 5",
      "known_cause_bug_complex": "Pipeline 6",
      "docs_followup": "Pipeline 7",
      "docs_only": "Pipeline 8"
    },
    "implementation_skill_for_features": "03-implement",
    "fixing_skill_for_bugs": "05-fix",
    "prohibited_fixing_skills_for_bugs": ["03-implement"],
    "docs_skill": "08-readme-management",
    "review_skill": "07-review",
    "auto_approve_intermediate_gates": true,
    "enforce_tdd_order": true,
    "require_review_pass": true
  },
  "search_policy": {
    "primary_label": "bounty",
    "default_labels": ["bounty", "algora", "polar", "help wanted", "feature", "enhancement", "bug", "documentation"],
    "max_issue_age_days": 14,
    "max_unresolved_comments": 20,
    "exclude_assigned": true,
    "exclude_issues_with_open_prs": true,
    "min_reward_usd": 20,
    "require_funded_status": true,
    "check_bounty_expiry": true,
    "github_api_base_url": "https://api.github.com",
    "github_search_endpoint": "https://api.github.com/search/issues",
    "algora_bounties_api_url": "https://api.algora.io/api/bounties",
    "polar_bounties_api_url": "https://api.polar.sh/api/v1/issues"
  },
  "eligibility_policy": {
    "require_verified_stripe_express": true,
    "supported_payout_platforms": ["algora", "polar", "github_bounties"],
    "min_acceptable_reward_usd": 20
  },
  "git_policy": {
    "branch_prefix_bug": "fix/bounty-issue-",
    "branch_prefix_feature": "feat/bounty-issue-",
    "branch_prefix_doc": "docs/bounty-issue-",
    "default_branch_prefix": "bounty/issue-",
    "commit_message_prefix_bug": "fix: ",
    "commit_message_prefix_feature": "feat: ",
    "commit_message_prefix_doc": "docs: ",
    "mandatory_issue_closing_keyword": "Fixes #",
    "enforce_clean_working_tree": true,
    "use_fork": true,
    "upstream_remote_name": "upstream",
    "origin_remote_name": "origin",
    "require_dco_signoff": true,
    "check_cla_requirements": true,
    "prevent_harness_logs_push": true,
    "excluded_paths_from_commit": [
      "docs/harness-logs/",
      "docs/harness-logs/**",
      ".env",
      "*.log",
      "*.tmp"
    ],
    "verify_clean_diff_against_upstream": true
  },
  "security_policy": {
    "sandbox_isolation_mode": "isolated_directory",
    "audit_dependencies_before_install": true,
    "prevent_unverified_lifecycle_scripts": true,
    "allowed_package_managers": ["npm", "pnpm", "yarn", "pip", "poetry", "cargo", "go"]
  },
  "verification_policy": {
    "baseline_test_timeout_seconds": 300,
    "require_reproduction_script": true,
    "require_regression_test": true,
    "require_ci_check_green": true,
    "max_ci_wait_timeout_minutes": 20,
    "require_harness_log_on_disk": true,
    "verify_harness_log_excluded_from_git": true
  }
}
